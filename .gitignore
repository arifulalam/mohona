# ---- Rust build output ----
/target/
**/target/
# Tauri generated files (schemas, capabilities cache)
app/src-tauri/gen/
# Windows debug symbols and build leftovers
*.pdb
*.ilk
*.exp
*.rlib
*.rmeta
**/*.rs.bk
# Cargo.lock is kept: this repository builds programs, not only a library

# ---- Node / web build output ----
node_modules/
dist/
extension/dist/
app/dist/
coverage/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tgz

# ---- Packaged files made for stores or releases ----
*.zip
*.crx
*.xpi
*.msi
*.nsis
app/src-tauri/target/release/bundle/

# ---- Tests ----
playwright-report/
test-results/
e2e/.tmp/
*.log

# ---- Local data and secrets: never commit ----
.env
.env.*
!.env.example
daemon.json
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.pem
*.key

# ---- Downloads made while testing ----
*.part
/downloads/
/Downloads/

# ---- Editors and systems ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Programs copied in for the installer (scripts/build-windows.ps1)
app/src-tauri/resources/*.exe
app/src-tauri/resources/extension/
app/src-tauri/binaries/
