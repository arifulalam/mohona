{
  "manifest_version": 3,
  "name": "Mohona",
  "version": "0.1.0",
  "description": "Send downloads from your browser to the Mohona download manager.",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "webRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Mohona",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
